# ============================================
# ProjectForge AI — Environment Configuration
# ============================================

# LLM PROVIDERS (enter at least one API key)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# WEB SEARCH
TAVILY_API_KEY=

# DATABASE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/projectforge

# APPLICATION
SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# PER-AGENT MODEL CONFIGURATION (format: provider/model-name)
# Examples:
#   groq/llama-3.3-70b-versatile
#   gemini/gemini-2.0-flash
#   openrouter/google/gemini-2.0-flash-exp:free
REQUIREMENT_AGENT_MODEL=groq/llama-3.3-70b-versatile
TECHNOLOGY_AGENT_MODEL=groq/llama-3.3-70b-versatile
ARCHITECTURE_AGENT_MODEL=groq/llama-3.3-70b-versatile
TASK_PLANNER_AGENT_MODEL=groq/llama-3.3-70b-versatile
TIMELINE_AGENT_MODEL=groq/llama-3.3-70b-versatile
CRITIC_AGENT_MODEL=groq/llama-3.3-70b-versatile
